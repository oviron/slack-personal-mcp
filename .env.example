# One line per workspace: SLACK_USER_TOKEN_<ALIAS>=xoxp-...  (SIDE_PROJECT becomes alias side-project)
SLACK_USER_TOKEN_ACME=
# App-level token, only for the Claude Code channel (--channel acme)
# SLACK_APP_TOKEN_ACME=xapp-...

# Optional
# SLACK_STYLE_GATE=off
# SLACK_READ_ONLY=1
# SLACK_FILE_ROOTS=/Users/me/Documents:/tmp
# SLACK_WRITE_CHANNELS=C0123ABCD,U0456EFGH
